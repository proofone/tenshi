{ // TODO: set directories + compile rules!
// TODO: Fix server model type imports
  "compilerOptions": {
    "isolatedModules": true,
    "composite": true,

    "noEmit": false,
    //"rootDir": "../",
    "outDir": "../public",
    "declarationDir": "./types/",

    "sourceMap": true,

    "noImplicitAny": true,
    "suppressExcessPropertyErrors": false,
    "strictNullChecks": true,

    "moduleResolution": "node",
    "module": "es6",
    "target": "es5",
    "jsx": "react",

    "allowJs": true,
    "allowSyntheticDefaultImports": true,
//    "allowImportingTsExtensions": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
  },
  "references": [
    {"path": "../node_server"}
  ],
  "exclude": ["webpack.config.js", "public", "types", "../tests"]
}

